{
  "manifest_version": 3,
  "name": "VoPro",
  "version": "1.0",
  "description": "VoPro is a browser extension for playvortex.io that adds a ton of new features! Such as stats, themes, streamer mode and more!",
  "content_scripts": [
    {
      "matches": ["https://playvortex.io/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icons/voproicontransparent.png"
  },

  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "browsingData"
  ],
  "host_permissions": [
    "*://*.playvortex.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["images/voprologo.png","icons/voproicontransparent.png","config.js","styles.css"],
      "matches": ["*://playvortex.io/*", "*://*.playvortex.io/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
